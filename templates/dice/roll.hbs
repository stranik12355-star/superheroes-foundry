<div class="superheroes dice-roll">
  <div class="dice-result">
    <div class="dice-formula"><span>{{formula}}</span></div>
    <div class="superheroes-tooltip">
      <ol class="superheroes-dice-tooltip-row">
        {{#each dice}}
          <li class="roll {{#if @index '===' 1}}superheroes-roll{{/if}} {{#if fantastic}}fantastic{{/if}}">
            <span>{{result}}</span>
          </li>
        {{/each}}
      </ol>
      <div class="superheroes-reroll-buttons">
        {{#each dice}}
          <div class="superheroes-reroll-cell">
            <button class="roll-edge" data-action="edge" data-index="{{@index}}">Edge</button>
            <button class="roll-trouble" data-action="trouble" data-index="{{@index}}">Trouble</button>
          </div>
        {{/each}}
      </div>
    </div>
    <h4 class="dice-total"><span>{{total}}</span></h4>
    <button class="damage">Damage</button>
  </div>
</div>