<div class="sh-chat-card {{#if critical}}critical{{/if}}">
  <div class="chat-title">{{label}}</div>
  {{#if (eq kind "check")}}
  <div class="dice-line">
    {{#each dice}}
      <div class="roll-die {{#if (and (eq @index 1) (eq this 1))}}middle critical-die{{else if (eq @index 1)}}middle{{/if}}">
        {{#if (and (eq @index 1) (eq this 1))}}★{{else}}{{this}}{{/if}}
      </div>
    {{/each}}
  </div>
  <div class="reroll-row">
    {{#each dice}}
      <div class="reroll-cell">
        <button type="button" data-action="reroll-die" data-message-id="{{../_id}}" data-die="{{@index}}">Перебросить</button>
      </div>
    {{/each}}
  </div>
  {{else}}
    <div class="attack-roll"><span>1d6 × {{multiplier}}</span><b>→ {{total}}</b></div>
  {{/if}}
  <div class="chat-total"><span>Результат</span><strong>{{total}}</strong></div>
  {{#if critical}}<div class="critical-note">★ КРИТИЧЕСКИЙ РЕЗУЛЬТАТ</div>{{/if}}
</div>
