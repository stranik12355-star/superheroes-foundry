<form class="superheroes-sheet" autocomplete="off" style="padding: 10px; background: #0d0d10; height: 100%; box-sizing: border-box;">
  <div style="margin-bottom: 10px;">
    <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">НАЗВАНИЕ</label>
    <input name="name" type="text" value="{{item.name}}" placeholder="Название" style="width: 100%; box-sizing: border-box; background: #111; border: 1px solid #a62c35; color: #fff; font-size: 16px; font-weight: bold; border-radius: 4px; padding: 5px 8px;">
  </div>
  
  <div style="height: calc(100% - 65px);">
    <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">ОПИСАНИЕ</label>
    <textarea name="system.description" placeholder="Введите описание..." style="width: 100%; height: 100%; box-sizing: border-box; background: #151519; border: 1px solid #2d2d34; color: #eee; border-radius: 4px; padding: 8px; font-size: 12px; line-height: 1.4; resize: none;">{{system.description}}</textarea>
  </div>
</form>