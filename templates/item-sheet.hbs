<form class="superheroes-sheet" autocomplete="off" style="padding: 10px; background: #0d0d10; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 10px;">
  
  <div>
    <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">НАЗВАНИЕ</label>
    <input name="name" type="text" value="{{item.name}}" placeholder="Название" style="width: 100%; box-sizing: border-box; background: #111; border: 1px solid #a62c35; color: #fff; font-size: 16px; font-weight: bold; border-radius: 4px; padding: 5px 8px;">
  </div>
  
  {{#if (eq item.type "power")}}
  <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 8px;">
    <div>
      <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">ФОКУС</label>
      <div style="display: flex; gap: 5px;">
        <input name="system.cost" type="number" value="{{system.cost}}" placeholder="0" style="width: 60px; background: #111; border: 1px solid #a62c35; color: #fff; font-size: 12px; font-weight: bold; border-radius: 4px; padding: 5px; text-align: center;">
        <input name="system.costExtra" type="text" value="{{system.costExtra}}" placeholder="или более / за раунд" style="flex: 1; background: #111; border: 1px solid #999; color: #eee; font-size: 12px; border-radius: 4px; padding: 5px;">
      </div>
    </div>
    <div style="display: flex; flex-direction: column; justify-content: flex-end; gap: 5px; padding-bottom: 5px;">
      <label style="cursor: pointer; color: #ffda33; font-size: 11px; font-weight: bold;">
        <input type="checkbox" name="system.reaction" {{#if system.reaction}}checked{{/if}}> ⚡ Реакция
      </label>
      <label style="cursor: pointer; color: #d899ff; font-size: 11px; font-weight: bold;">
        <input type="checkbox" name="system.concentration" {{#if system.concentration}}checked{{/if}}> 👁 Концентрация
      </label>
    </div>
  </div>
  
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: #151519; padding: 8px; border: 1px solid #2d2d34; border-radius: 6px;">
    <div>
      <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">ТРЕБОВАНИЯ</label>
      <input name="system.requirements" type="text" value="{{system.requirements}}" style="width: 100%; box-sizing: border-box; background: #1a1a1f; border: 1px solid #444; color: #eee; font-size: 11px; border-radius: 4px; padding: 4px 6px;">
    </div>
    <div>
      <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">ДЕЙСТВИЕ</label>
      <input name="system.action" type="text" value="{{system.action}}" style="width: 100%; box-sizing: border-box; background: #1a1a1f; border: 1px solid #444; color: #eee; font-size: 11px; border-radius: 4px; padding: 4px 6px;">
    </div>
    <div>
      <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">ВЫЗВАНО (ТРИГГЕР)</label>
      <input name="system.trigger" type="text" value="{{system.trigger}}" style="width: 100%; box-sizing: border-box; background: #1a1a1f; border: 1px solid #444; color: #eee; font-size: 11px; border-radius: 4px; padding: 4px 6px;">
    </div>
    <div>
      <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">ПРОДОЛЖИТЕЛЬНОСТЬ</label>
      <input name="system.duration" type="text" value="{{system.duration}}" style="width: 100%; box-sizing: border-box; background: #1a1a1f; border: 1px solid #444; color: #eee; font-size: 11px; border-radius: 4px; padding: 4px 6px;">
    </div>
  </div>
  {{/if}}

  <div style="flex: 1; display: flex; flex-direction: column;">
    <label style="display: block; color: #777; font-size: 9px; letter-spacing: 1px; margin-bottom: 4px;">ЭФФЕКТ (ОПИСАНИЕ)</label>
    <textarea name="system.description" placeholder="Введите описание..." style="width: 100%; flex: 1; box-sizing: border-box; background: #151519; border: 1px solid #2d2d34; color: #eee; border-radius: 4px; padding: 8px; font-size: 12px; line-height: 1.4; resize: none;">{{system.description}}</textarea>
  </div>
  
</form>