{{#if parts.length}}
<!-- ГЛАВНЫЙ КОНТЕЙНЕР: выстраивает 3 секции в ряд по горизонтали -->
<div class="superheroes-tooltip" style="display: flex !important; flex-direction: row !important; justify-content: center !important; gap: 15px !important; padding-bottom: 5px;">
  
  {{#each parts}}
    <!-- СЕКЦИЯ: это колонка, в которой ровно 1 кубик и 2 кнопки под ним -->
    <section class="tooltip-part" style="margin: 0 !important; padding: 0 !important; border: none !important; display: flex !important; flex-direction: column !important; align-items: center !important; gap: 5px !important;">
      
      <div class="dice" style="margin: 0 !important; padding: 0 !important;">
        <ol class="dice-rolls superheroes-dice-tooltip-row" style="list-style: none !important; margin: 0 !important; padding: 0 !important;">
          {{#each rolls}}
            <!-- САМ КУБИК -->
            <li class="roll {{ classes }}" style="width: 40px !important; height: 40px !important; display: grid !important; place-items: center !important; margin: 0 !important; flex: 0 0 auto !important;">
              {{#if @root.isPrivate}}?{{ else }}{{ result }}{{/if}}
            </li>
          {{/each}}
        </ol>
      </div>

      <!-- КНОПКИ: проверяем, что всего секций 3 (значит это наш бросок) -->
      {{#if (eq ../parts.length 3)}}
      <div class="superheroes-reroll-cell" style="display: flex !important; flex-direction: column !important; width: 40px !important; gap: 4px !important; align-items: center !important;">
        
        <!-- КНОПКА: Преимущество -->
        <button type="button" class="retroEdgeMode" data-retro-action="edge" data-index="{{@index}}" title="С преимуществом" style="background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; font-size: 8.5px !important; color: #888 !important; cursor: pointer !important; text-transform: uppercase !important; font-weight: bold !important; line-height: 1 !important; width: auto !important;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#888'">Преим.</button>
        
        <!-- КНОПКА: Помеха -->
        <button type="button" class="retroEdgeMode" data-retro-action="trouble" data-index="{{@index}}" title="С помехой" style="background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; font-size: 8.5px !important; color: #888 !important; cursor: pointer !important; text-transform: uppercase !important; font-weight: bold !important; line-height: 1 !important; width: auto !important;" onmouseover="this.style.color='#d34a53'" onmouseout="this.style.color='#888'">Помеха</button>
        
      </div>
      {{/if}}

    </section>
  {{/each}}

</div>
{{/if}}
