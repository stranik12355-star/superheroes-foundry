{{#if parts.length}}
<!-- ВАЖНО: Добавлено выравнивание в ряд прямо сюда -->
<div class="superheroes-tooltip" style="display: flex !important; flex-direction: row !important; justify-content: center !important; gap: 10px !important;">
  {{#each parts}}
    <section class="tooltip-part" style="margin: 0 !important; padding: 0 !important; border: none !important;">
      <div class="dice">
        <ol class="dice-rolls superheroes-dice-tooltip-row" style="margin: 0 !important; padding: 0 !important; list-style: none !important;">
          {{#each rolls}}
            <li class="roll {{ classes }}" style="width: 40px !important; height: 40px !important; display: grid !important; place-items: center !important; flex: 0 0 auto !important;">
              {{#if @root.isPrivate}}?{{ else }}{{ result }}{{/if}}
            </li>
          {{/each}}
        </ol>
        {{#if (eq rolls.length 3)}}
        <div class="superheroes-reroll-grid">
          {{#each rolls}}
            <div class="superheroes-reroll-cell">
              <button type="button" class="retroEdgeMode" data-retro-action="edge" data-index="{{@index}}">Преимущество</button>
              <button type="button" class="retroEdgeMode" data-retro-action="trouble" data-index="{{@index}}">Помеха</button>
            </div>
          {{/each}}
        </div>
        {{/if}}
      </div>
    </section>
  {{/each}}
</div>
{{/if}}
