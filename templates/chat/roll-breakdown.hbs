{{#if parts.length}}
<div class="dice-tooltip superheroes-tooltip">
  {{#each parts}}
    <section class="tooltip-part">
      <div class="dice">
        <ol class="dice-rolls">
          {{#each rolls}}
            <li class="roll {{classes}}">
              <span>{{#if @root.isPrivate}}?{{else}}{{result}}{{/if}}</span>
            </li>
          {{/each}}
        </ol>
        {{#if (eq rolls.length 3)}}
        <div class="superheroes-reroll-buttons">
          {{#each rolls}}
            <div class="superheroes-reroll-cell">
              <button type="button" data-action="superheroes-reroll" data-die-index="{{@index}}">Преимущество</button>
              <button type="button" data-action="superheroes-reroll" data-die-index="{{@index}}" data-mode="trouble">Помеха</button>
            </div>
          {{/each}}
        </div>
        {{/if}}
      </div>
    </section>
  {{/each}}
</div>
{{/if}}
