{{#if parts.length}}
<div class="superheroes-tooltip">
  {{#each parts}}
    <section class="tooltip-part">
      <div class="dice">
        <!-- ДОБАВЛЕН КЛАСС flexrow СЮДА -->
        <ol class="dice-rolls superheroes-dice-tooltip-row flexrow">
          {{#each rolls}}
            <li class="roll {{ classes }}">
              {{#if @root.isPrivate}}?{{ else }}{{ result }}{{/if}}
            </li>
          {{/each}}
        </ol>
        {{#if (eq rolls.length 3)}}
        <!-- ДОБАВЛЕН КЛАСС flexrow СЮДА -->
        <div class="superheroes-reroll-grid flexrow">
          {{#each rolls}}
            <div class="superheroes-reroll-cell">
              <button type="button" class="retroEdgeMode" data-retro-action="edge" data-index="{{@index}}">Преимущество</button>
              <button type="button" class="retroEdgeMode" data-retro-action="trouble" data-index="{{@index}}">Помеха</button>
            </div>
          {{/each}}
        </div>
        {{/if}}
      </div>
    </section>
  {{/each}}
</div>
{{/if}}