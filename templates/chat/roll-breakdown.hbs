{{#if parts.length}}
<div class="superheroes-tooltip" style="padding-bottom: 5px;">
  {{#each parts}}
    <section class="tooltip-part" style="margin: 0 !important; padding: 0 !important; border: none !important;">
      
      <!-- КОНТЕЙНЕР БРОСКА -->
      <div class="dice-rolls superheroes-dice-tooltip-row" style="display: flex !important; flex-direction: row !important; justify-content: center !important; gap: 12px !important; list-style: none !important; margin: 0 !important; padding: 0 !important;">
        
        {{#each rolls}}
          <!-- ЕДИНАЯ КОЛОНКА ДЛЯ ОДНОГО КУБИКА И ЕГО КНОПОК -->
          <div class="die-column" style="display: flex !important; flex-direction: column !important; align-items: center !important; gap: 5px !important;">
            
            <!-- САМ КУБИК -->
            <div class="roll {{ classes }}" style="width: 40px !important; height: 40px !important; display: grid !important; place-items: center !important; flex: 0 0 auto !important;">
              {{#if @root.isPrivate}}?{{ else }}{{ result }}{{/if}}
            </div>
            
            <!-- КНОПКИ ПОД КУБИКОМ -->
            {{#if (eq ../rolls.length 3)}}
            <div class="buttons-column" style="display: flex !important; flex-direction: column !important; gap: 3px !important; width: 40px !important; align-items: center !important;">
              <button type="button" class="retroEdgeMode" data-retro-action="edge" data-index="{{@index}}" title="С преимуществом" style="background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; font-size: 8.5px !important; color: #888 !important; cursor: pointer !important; text-transform: uppercase !important; font-weight: bold !important; line-height: 1 !important;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#888'">Преим.</button>
              <button type="button" class="retroEdgeMode" data-retro-action="trouble" data-index="{{@index}}" title="С помехой" style="background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; font-size: 8.5px !important; color: #888 !important; cursor: pointer !important; text-transform: uppercase !important; font-weight: bold !important; line-height: 1 !important;" onmouseover="this.style.color='#d34a53'" onmouseout="this.style.color='#888'">Помеха</button>
            </div>
            {{/if}}

          </div>
        {{/each}}
        
      </div>
    </section>
  {{/each}}
</div>
{{/if}}
